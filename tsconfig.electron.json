/* This is the TypeScript configuration file for the Electron part of the ApothecaryProjects project.
   It specifies the compiler options and settings for TypeScript, including the target
   JavaScript version, module system, and path aliases. */
{
    "compilerOptions": {
        "target": "ESNext",
        "module": "node16",
        "moduleResolution": "node16",
        "strict": true,

        "rootDir": "./electron",
        "outDir": "./dist-electron",

        "paths": {
            "@/*": ["./src/*"]
        },
    },
    "include": ["electron"]
}