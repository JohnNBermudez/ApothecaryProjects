/* This is the TypeScript configuration file for the ApothecaryProjects project.
   It specifies the compiler options and settings for TypeScript, including the target
   JavaScript version, module system, JSX support, and path aliases. */
{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "strict": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"]
}