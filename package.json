{
    "name": "electron-white-gui",
    "version": "1.0.0",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "electron": "npm run build:electron && electron .",
        "start": "npm-run-all -p --race electron dev",
        "generate:icon": "node scripts/generate-icons.js",
        "build:renderer": "vite build",
        "build:electron": "tsc -p tsconfig.electron.json",
        "build": "npm run generate:icon && npm run build:renderer && npm run build:electron",
        "dist:win": "npm run build && electron-builder --win nsis"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "electron": "^44.8.0",
        "electron-builder": "^26.18.0",
        "npm-run-all": "^4.1.5",
        "png2icons": "^2.0.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "ts-loader": "^9.6.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    },
    "description": "A desktop Project Launcher App with a Old Library Aesthetic with the goal of making Project management simple and Fun. I hope This Project can help add some Soul Behind the Syntax.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JohnNBermudez/ApothecaryProjects.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/JohnNBermudez/ApothecaryProjects/issues"
    },
    "homepage": "https://github.com/JohnNBermudez/ApothecaryProjects#readme",
    "build": {
        "appId": "com.apothecaryprojects.bookcase",
        "productName": "Application Bookcase",
        "directories": {
            "buildResources": "build",
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/main.js",
            "dist-electron/preload.js",
            "package.json",
            "!**/*.map"
        ],
        "extraResources": [
            {
                "from": "build/icon.ico",
                "to": "app-icon.ico"
            }
        ],
        "win": {
            "icon": "build/icon.ico",
            "target": "nsis",
            "artifactName": "BookcaseInstaller.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Application Bookcase",
            "uninstallDisplayName": "Application Bookcase",
            "installerIcon": "build/icon.ico",
            "uninstallerIcon": "build/icon.ico"
        }
    }
}
